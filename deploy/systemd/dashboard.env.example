ACF_CONFIG=/opt/acf/config.yml
ACF_DASHBOARD_USER=admin
# Generate a value with: python3 -c "from werkzeug.security import generate_password_hash; print(generate_password_hash(input()))"
ACF_DASHBOARD_PASSWORD_HASH=replace-with-a-werkzeug-password-hash
ACF_FORCE_HTTPS=true
ACF_AUTH_MAX_ATTEMPTS=10
ACF_AUTH_WINDOW_SECONDS=900
